FROM mcr.microsoft.com/playwright/python:v1.57.0-noble

ENV PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb fluxbox x11-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements_webrtc.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY vip_webrtc.py /app/vip_webrtc.py
COPY start_webrtc.sh /app/start_webrtc.sh
RUN chmod +x /app/start_webrtc.sh

CMD ["/app/start_webrtc.sh"]
